// Joy Rush — Prisma schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductType {
  DRINK
  GUMMY
  BUNDLE
  BANGLE
  OTHER
}

enum OrderStatus {
  PENDING // created, awaiting payment
  PAID // payment verified
  FULFILLED // handed to Shiprocket
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id        String    @id @default(cuid())
  clerkId   String    @unique
  email     String    @unique
  name      String?
  imageUrl  String?
  role      Role      @default(CUSTOMER)
  addresses Address[]
  orders    Order[]
  reviews   Review[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[]
}

model Product {
  id             String      @id @default(cuid())
  name           String
  slug           String      @unique
  tagline        String? // short punchy line
  description    String
  type           ProductType @default(DRINK)
  price          Int // in paise (INR * 100)
  compareAtPrice Int? // strike-through price, in paise
  images         String[] // Cloudinary (or other) URLs
  accentColor    String      @default("brand-berry") // token used for card theming
  flavor         String?
  mood           String? // for gummies: Social Spark, Sweet Dreams...
  sizes          String[] // for bangles: 2.2, 2.4, 2.6, 2.8
  benefits       String[] // bullet points
  ingredients    String?
  stock          Int         @default(0)
  featured       Boolean     @default(false)
  isActive       Boolean     @default(true)
  categoryId     String?
  category       Category?   @relation(fields: [categoryId], references: [id])
  orderItems     OrderItem[]
  reviews        Review[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([type])
  @@index([featured])
}

model Address {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name    String
  phone   String
  line1   String
  line2   String?
  city    String
  state   String
  pincode String
  country String  @default("India")
  isDefault Boolean @default(false)
  orders  Order[]
  createdAt DateTime @default(now())
}

model Order {
  id        String      @id @default(cuid())
  number    Int         @unique @default(autoincrement())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  email     String
  status    OrderStatus @default(PENDING)
  items     OrderItem[]

  subtotal     Int
  discount     Int @default(0)
  shippingCost Int @default(0)
  total        Int

  // Shipping address snapshot
  addressId    String?
  address      Address? @relation(fields: [addressId], references: [id])
  shipName     String
  shipPhone    String
  shipLine1    String
  shipLine2    String?
  shipCity     String
  shipState    String
  shipPincode  String
  shipCountry  String  @default("India")

  // Razorpay
  razorpayOrderId   String? @unique
  razorpayPaymentId String?

  // Shiprocket
  shiprocketOrderId    String?
  shiprocketShipmentId String?
  awbCode              String?
  courierName          String?
  trackingUrl          String?
  labelUrl             String?

  // Customer emails: kinds sent so far ("confirmed", "shipped", "delivered",
  // "refunded") and the last send error, shown in the admin.
  emailsSent String[] @default([])
  emailError String?

  // Refunds (Razorpay). refundStatus is "requesting" while a refund call is
  // in flight (a lock against double refunds), then Razorpay's status.
  refundedAmount   Int     @default(0)
  refundStatus     String?
  razorpayRefundId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([userId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  name      String
  image     String?
  price     Int // unit price in paise (snapshot)
  quantity  Int
  size      String?
}

/// Store configuration editable from the admin panel. One row per section
/// (identity, theme, commerce, homepage); `data` is validated by the zod
/// schemas in lib/settings/schema.ts, so new settings need no migration.
model SiteSetting {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

/// Admin-managed content pages (About, policies, custom SEO pages).
model Page {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  content        String   @default("") // markdown
  seoTitle       String?
  seoDescription String?
  isPublished    Boolean  @default(true)
  showInFooter   Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  author    String
  rating    Int // 1..5
  comment   String
  images    String[] // customer-uploaded photos (Cloudinary URLs)
  createdAt DateTime @default(now())

  @@index([productId])
}
