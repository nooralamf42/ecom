# ----- Database (Neon / any PostgreSQL) -----
# Pooled connection string used by the app at runtime
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Direct (non-pooled) connection used by Prisma migrate
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ----- Clerk (auth) -----
# In development you may leave these blank to use Clerk "keyless" mode.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SIGNING_SECRET=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# ----- Cloudinary (images) -----
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Optional unsigned upload preset for the admin uploader
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="store_unsigned"

# ----- Razorpay (payments) -----
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ----- Shiprocket (shipping) -----
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
# Pickup location nickname configured in your Shiprocket dashboard
SHIPROCKET_PICKUP_LOCATION="Primary"

# ----- Resend (order emails) -----
RESEND_API_KEY=""
# Optional fallback sender address, e.g. orders@mystore.com. Normally set in
# Admin → Settings → Store & SEO → Order emails (the sender name is always the
# store name). If neither is set, Resend's test sender is used, which only
# delivers to your own Resend account email.
EMAIL_FROM=""

# ----- App -----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Signs the cookie that lets guests see their orders on this device.
# Optional: falls back to CLERK_SECRET_KEY. Any long random string.
ORDER_ACCESS_SECRET=""
# Comma-separated Clerk user IDs or emails granted admin access (fallback to DB role)
ADMIN_EMAILS="you@example.com"
